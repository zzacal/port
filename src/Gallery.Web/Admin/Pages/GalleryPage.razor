@* 009 gallery builder (contracts/components.md C3, contracts/http.md B1). The 005 GalleryBuilder
   with its K6 parameters: per-tile drag handle, cover pin/unpin, Remove and View ↗ in the row under
   each title (UI-2); Save is the one primary (UI-3); 010 owner review 1: the breadcrumb is the way back, and the
   panel's View gallery ↗ shows only when the gallery has photos and posts title, description and the Public
   switch together (B2, owner feedback: no separate publish confirm, the warning has no buttons); Delete gallery… is outlined Danger and Remove is Quiet with no confirmation (UI-4,
   FR-024); limits from LibraryOptions (UI-7); no validation nags (UI-8). Per-item controls post the
   hidden forms below through form="…" (no nested forms); the title and description inputs belong
   to the b-panel form that wraps the builder, and so does the switch. reorder.js drives the grid. *@
@using Gallery.Web.Components
@using Gallery.Web.Components.Atoms
@using Gallery.Web.Components.Molecules
@using Gallery.Web.Components.Organisms
@using Gallery.Web.Components.Templates
@using Gallery.Web.Library

<AdminLayout Title="@G.Title" Current="AdminPage.Galleries" SignOut="@Model.Csrf" Crumbs="Crumbs">
    <section class="gb">
        <form id="b-order" method="post" action="@($"{Base}/order")" hidden>@Token@foreach (var item in Model.Items)
            {
                <input type="hidden" name="order" value="@item.Id">
            }</form>
        <form id="b-cover" method="post" action="@($"{Base}/cover")" hidden>@Token</form>
        <form id="b-unpin" method="post" action="@($"{Base}/cover")" hidden>@Token</form>
        <form id="b-remove" method="post" action="@($"{Base}/remove")" hidden>@Token</form>
        <form id="b-delete" method="post" action="@($"{Base}/delete")" hidden>@Token</form>
        <form id="b-panel" method="post" action="@Base">
            @Token
            <GalleryBuilder Title="@(Model.EditTitle ?? G.Title)" Description="@Model.EditDescription" Public="@IsPublic" PublicChecked="@Model.EditPublic"
                            Items="@Model.Items" ItemIds="@ItemIds" State="@State" PinnedIndex="@PinnedIndex"
                            ViewHref="@(PhotoHrefBase ?? "/g")" ShowView="@Model.HasPhotos" FormId="b-panel"
                            RemoveFormId="b-remove" CoverFormId="b-cover" UnpinFormId="b-unpin" OrderFormId="b-order"
                            DeleteFormId="b-delete"
                            PhotoHrefBase="@PhotoHrefBase" PublicDisabledReason="@GalleriesPage.DisabledReasonFor(Ref)"
                            TitleMax="@Model.Options.TitleMax" DescriptionMax="@Model.Options.DescriptionMax" Status="@Model.Status" />
        </form>
        <script type="module" src="@Model.ReorderScriptUrl"></script>
        <script type="module" src="@Model.LibraryScriptUrl"></script>
    </section>
</AdminLayout>

@code {
    [Parameter, EditorRequired] public GalleryPageModel Model { get; set; } = default!;

    private Gallery.Web.Data.GalleryDoc G => Model.Gallery;
    private string Base => $"/admin/galleries/{G.Id}";
    private bool IsPublic => G.Visibility == "public";

    /// <summary>The gallery as the list sees it, for the shared disabled-reason rule.</summary>
    private GalleryRef Ref => new(G.Id, G.Slug, G.Title, G.Visibility, Model.Items.Count);

    private string? PhotoHrefBase => Model.HasPhotos ? $"/g/{G.Id}/{G.Slug}" : null;

    /// <summary>010 owner review 1 (B6): "Galleries › {title}" under the owner bar.</summary>
    private IReadOnlyList<Crumb> Crumbs => [new("Galleries", "/admin/galleries"), new(G.Title)];

    private IReadOnlyList<string> ItemIds => Model.Items.Select(i => i.Id).ToList();

    private int? PinnedIndex
    {
        get
        {
            if (G.PinnedCover is null) return null;
            for (var i = 0; i < Model.Items.Count; i++)
                if (Model.Items[i].Id == G.PinnedCover) return i;
            return null;
        }
    }

    private BuilderState State =>
        !Model.HasPhotos ? BuilderState.Empty : BuilderState.Rest;

    private RenderFragment Token => @<input type="hidden" name="@Model.Csrf.FieldName" value="@Model.Csrf.Value">;
}
