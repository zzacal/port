@* 017 photo edit screen (contracts/components.md P1, contracts/http.md L6). One photo in main,
   as large as the column allows and wholly visible (Picture, Sizes.ForAside(), Contain, the solo
   view's 80vh stage); the photo panel (moved from the library page, 015/014) in AdminLayout's aside,
   stacked after the photo below 1200 px. The breadcrumb goes back to the library page the owner
   came from, at this photo's tile (US2). Save is the one filled action (UI-3); Delete photo… is
   outlined Danger (UI-4); limits come from LibraryOptions (UI-7); no validation nags (UI-8). The
   photo is not a link; View ↗ in the panel goes to the public page. library.js drives the
   combobox and the DangerConfirm fallback. *@
@using Gallery.Web.Components
@using Gallery.Web.Components.Atoms
@using Gallery.Web.Components.Molecules
@using Gallery.Web.Components.Organisms
@using Gallery.Web.Components.Templates
@using Gallery.Web.Library

<AdminLayout Title="@Model.Photo.Image.Title" Current="AdminPage.Library" SignOut="@Model.Csrf" Crumbs="Crumbs" Aside="@Panel(Model.Photo)">
    <section class="pe">
        <form id="lib-del-one" method="post" action="@($"/admin/library/images/{Model.Photo.Image.Id}/delete")" hidden>@Token<input type="hidden" name="page" value="@Model.ReturnPage"></form>
        @if (Model.Status is not null)
        {
            <p class="lib-result" role="status">@Model.Status</p>
        }
        <div class="pe-stage">
            <Picture Image="Model.Photo.Image" Sizes="@StageSizes" Fit="PictureFit.Contain" Priority="PicturePriority.High" ShowThumbLayer="true" />
        </div>
        <script type="module" src="@Model.LibraryScriptUrl"></script>
    </section>
</AdminLayout>

@code {
    [Parameter, EditorRequired] public PhotoEditPageModel Model { get; set; } = default!;

    private static readonly string StageSizes = Gallery.Core.Images.Sizes.ForAside();

    private string TitlePattern => LibraryPage.TitlePattern;

    private IReadOnlyList<Crumb> Crumbs =>
        [new("Library", $"/admin/library?page={Model.ReturnPage}#t-{Model.Photo.Image.Id}"), new(Model.Photo.Image.Title)];

    private RenderFragment Token => @<input type="hidden" name="@Model.Csrf.FieldName" value="@Model.Csrf.Value">;

    private static RenderFragment? ViewFor(string? href) => href is null
        ? null
        : @<TextLink Href="@href" Target="_blank">View &#x2197;</TextLink>;

    private RenderFragment Panel(LibraryTile open) =>
        @<form id="lib-edit" class="lib-edit" method="post" action="@($"/admin/library/images/{open.Image.Id}")">
            @Token<input type="hidden" name="page" value="@Model.ReturnPage">
            <SidePanel Heading="Photo" FormId="lib-edit" State="@(Model.Saved ? SaveState.Saved : SaveState.Idle)" Danger="@DangerFor(open)">
                <Input Label="Title" Name="title" Value="@Model.EditTitle" MaxLength="@Model.Options.TitleMax" Required="true" Pattern="@TitlePattern" />
                <Input Label="Caption" Name="caption" Multiline="true" Value="@Model.EditCaption" MaxLength="@Model.Options.CaptionMax" />
                <TokenCombobox Id="lib-gf" Label="Galleries" Tokens="@TokensFor(open)" Options="@GalleryOptions"
                               AddName="add" CreateName="create" RemoveName="leave" Removed="@(Model.EditLeave ?? [])"
                               AllowCreate="true" CreateMax="@Model.Options.TitleMax" MaxShown="10"
                               EmptyText="Not in a gallery" RemoveLabel="Remove from {0}"
                               WarningFormat="{0}: visitors will see this photo after you save." />
                @ViewFor(open.ViewHref)
            </SidePanel>
        </form>;

    /// <summary>
    /// 014 K3: the photo's holders by title (ignore-case, then id) as saved tokens, minus any id the
    /// refused save was leaving; then the refused save's pending adds (skipped when the gallery is
    /// gone) and pending creates, so a 422 re-render keeps what the owner picked.
    /// </summary>
    private IReadOnlyList<ComboToken> TokensFor(LibraryTile open)
    {
        var leave = Model.EditLeave ?? [];
        var tokens = open.Galleries
            .Where(g => !leave.Contains(g.Id, StringComparer.Ordinal))
            .OrderBy(g => g.Title, StringComparer.OrdinalIgnoreCase)
            .ThenBy(g => g.Id, StringComparer.Ordinal)
            .Select(g => new ComboToken(g.Id, g.Title, $"/admin/galleries/{g.Id}"))
            .ToList();
        foreach (var id in Model.EditAdd ?? [])
        {
            var g = Model.Galleries.FirstOrDefault(x => x.Id == id);
            if (g is not null) tokens.Add(new ComboToken(g.Id, g.Title, Pending: ComboPending.Add));
        }
        foreach (var title in Model.EditCreate ?? [])
            tokens.Add(new ComboToken(title, title, Pending: ComboPending.Create));
        return tokens;
    }

    /// <summary>014 K3: every gallery as a combobox option; a public one carries the visitor warning.</summary>
    private IReadOnlyList<ComboOption> GalleryOptions => Model.Galleries
        .Select(g => new ComboOption(g.Id, g.Title, g.IsPublic ? "Public" : "Private", g.IsPublic ? $"{g.Title} is public" : null))
        .ToList();

    private static RenderFragment DangerFor(LibraryTile open) =>
        @<DangerConfirm Action="Delete photo" Target="@open.Image.Title" Title="@($"Delete \u201C{open.Image.Title}\u201D?")" Consequence="@DeleteConsequence(open.GalleryCount)"
                        ConfirmLabel="Delete photo" FormId="lib-del-one" />;

    /// <summary>contracts/components.md "delete confirm (one)".</summary>
    public static string DeleteConsequence(int galleries) => Gallery.Web.Workspace.Messages.DeleteConsequence(galleries);
}
