@* 009 gallery list (contracts/components.md C2, contracts/http.md G1). Server-rendered from the 005
   components; library.js (Batch F) submits a card's visibility form when its switch changes, which
   publishes or unpublishes at once (no confirmation step; DEFAULT decision, owner may overturn), and
   opens the New gallery dialog; reorder.js rewrites gal-order and submits it on drop.
   Owner UI rules: each card with photos links to its public page and every card to its builder
   (UI-1); status, handle, switch, View and Edit sit in .gal-row under the title (UI-2); "New gallery"
   is the one primary (UI-3), in the page heading row beside the title (010 owner review 1); the switch renders its
   stored state and an empty private gallery's switch is disabled with the reason (UI-5). *@
@using Gallery.Web.Components
@using Gallery.Web.Components.Atoms
@using Gallery.Web.Components.Molecules
@using Gallery.Web.Components.Organisms
@using Gallery.Web.Components.Templates
@using Gallery.Web.Library

<AdminLayout Title="Galleries" Current="AdminPage.Galleries" SignOut="@Model.Csrf">
    <section class="gal">
        <form id="gal-order" method="post" action="/admin/galleries/order" hidden>@Token@foreach (var row in Model.Rows)
            {
                <input type="hidden" name="order" value="@row.Gallery.Id">
            }</form>
        @foreach (var row in Model.Rows)
        {
            <form id="@($"gal-vis-{row.Gallery.Id}")" method="post" action="@($"/admin/galleries/{row.Gallery.Id}/visibility")" hidden>@Token<input type="hidden" name="from" value="list"></form>
        }
        <PageHeading Text="Galleries" Actions="@NewGallery" />
        @if (Model.Status is not null)
        {
            <p class="gal-result" role="status">@Model.Status</p>
        }
        @if (Model.Rows.Count == 0)
        {
            <p class="gal-empty">No galleries yet. Use &#x201C;New gallery&#x201D; to start one.</p>
        }
        else
        {
            <reorder-grid data-form="gal-order">
                <ContactSheet Large="3" Medium="3" Small="1">
                    @for (var i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        var position = i + 1;
                        @CardFor(row, position)
                    }
                </ContactSheet>
            </reorder-grid>
        }
        <dialog id="gal-new" class="gal-new" aria-labelledby="gal-new-h">
            <form method="post" action="/admin/galleries">
                @Token
                <h2 id="gal-new-h">New gallery</h2>
                <Input Label="Title" Name="title" Required="true" Pattern="@TitlePattern" MaxLength="@Model.Options.TitleMax" />
                <div class="gal-new-actions">
                    <Button Variant="ButtonVariant.Primary">Create</Button>
                    <Button Variant="ButtonVariant.Quiet" Type="button" Name="action" Value="cancel">Cancel</Button>
                </div>
            </form>
        </dialog>
        <script type="module" src="@Model.ReorderScriptUrl"></script>
        <script type="module" src="@Model.LibraryScriptUrl"></script>
    </section>
</AdminLayout>

@code {
    [Parameter, EditorRequired] public GalleriesPageModel Model { get; set; } = default!;

    /// <summary>The single-line title rule the server applies (not whitespace-only, FR-010).</summary>
    public const string TitlePattern = @".*\S.*";

    private static readonly string GridSizes = Gallery.Core.Images.Sizes.ForGrid(3, 3, 1);

    private RenderFragment NewGallery =>
        @<Button Variant="ButtonVariant.Primary" Type="button" Name="action" Value="new-gallery">New gallery</Button>;

    private RenderFragment Token => @<input type="hidden" name="@Model.Csrf.FieldName" value="@Model.Csrf.Value">;

    private static string? CardClass(GalleryRow row) => row.Gallery.IsPublic ? null : "is-private";

    /// <summary>
    /// The disabled reason (K3) for a gallery that cannot be published: empty AND private. An empty
    /// PUBLIC gallery keeps a working switch so the owner can still unpublish it.
    /// </summary>
    public static string? DisabledReasonFor(GalleryRef g) =>
        g.PhotoCount == 0 && !g.IsPublic ? GalleryService.EmptyPublishReason : null;

    private RenderFragment CardFor(GalleryRow row, int position) => row.Cover is null
        ? @<div class="@EmptyClass(row)"><div class="cell"></div><Title Text="@row.Gallery.Title" />@RowFor(row, position)</div>
        : @<Tile Image="@row.Cover" Sizes="@GridSizes" CssClass="@CardClass(row)" Caption="@RowFor(row, position)" />;

    private static string EmptyClass(GalleryRow row) =>
        row.Gallery.IsPublic ? "gal-tile tile-empty" : "gal-tile tile-empty is-private";

    private RenderFragment RowFor(GalleryRow row, int position) =>
        @<div class="gal-row"><span class="gal-status">@row.Status</span><DragHandle Label="@($"Move {row.Gallery.Title}")" Position="@position" Total="@Model.Rows.Count" /><VisibilityToggle Public="@row.Gallery.IsPublic" FormId="@($"gal-vis-{row.Gallery.Id}")" GalleryTitle="@row.Gallery.Title" PhotoCount="@row.Gallery.PhotoCount" DisabledReason="@DisabledReasonFor(row.Gallery)" />@ViewFor(row)<TextLink Href="@($"/admin/galleries/{row.Gallery.Id}")">Edit</TextLink></div>;

    private static RenderFragment? ViewFor(GalleryRow row) => row.HasPhotos
        ? @<TextLink Href="@($"/g/{row.Gallery.Id}/{row.Gallery.Slug}")" Target="_blank">View &#x2197;</TextLink>
        : null;
}
