    private static readonly GalleryNeighbour Short = new("#", "Coast walk");
    private static readonly GalleryNeighbour Medium = new("#", "Alpine lakes and the high pass");
    private static readonly GalleryNeighbour Long = new("#", "Birds of the northern estuary, photographed through three long winters");
}
