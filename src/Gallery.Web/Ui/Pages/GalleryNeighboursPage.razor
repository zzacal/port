    <Specimen Label="Last gallery"><GalleryNeighbours Prev="Short" /></Specimen>
    <Specimen Label="Long titles" Width="w-480"><GalleryNeighbours Prev="Long" Next="Medium" /></Specimen>
</UiLayout>

