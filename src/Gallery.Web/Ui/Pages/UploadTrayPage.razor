<UiLayout Title="UploadTray">
    <Specimen Label="Empty">
        <UploadTray State="TrayState.Empty" MaxPhotos="100" />
    </Specimen>
    <Specimen Label="Working">
        <UploadTray State="TrayState.Working" Rows="Working" Added="2" Total="5" />
    </Specimen>
    <Specimen Label="Hidden">
        <UploadTray State="TrayState.Hidden" Rows="Working" Added="2" Total="5" />
    </Specimen>
    <Specimen Label="Finished">
        <UploadTray State="TrayState.Finished" Destination="Desert" Rows="Finished" Added="3" Total="3" />
    </Specimen>
    <Specimen Label="Finished with failures">
        <UploadTray State="TrayState.FinishedWithFailures" Rows="WithFailures" Added="3" Total="5" />
    </Specimen>
    <Specimen Label="Public destination" Note="The notice shows in every state while the destination is public.">
        <UploadTray State="TrayState.Working" Destination="Coast" DestinationPublic="true" Rows="Working" Added="2" Total="5" />
    </Specimen>
    <Specimen Label="Phone width" Note="Constrained to 390 px." Width="w-390">
        <UploadTray State="TrayState.Working" Destination="Coast" DestinationPublic="true" Rows="Working" Added="2" Total="5" />
    </Specimen>
</UiLayout>

