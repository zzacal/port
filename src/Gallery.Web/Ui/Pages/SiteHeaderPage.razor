<UiLayout Title="SiteHeader">
    <Specimen Label="Home"><SiteHeader Crumbs="@Home" /></Specimen>
    <Specimen Label="Gallery page"><SiteHeader Crumbs="@Gallery" /></Specimen>
    <Specimen Label="Photo page"><SiteHeader Crumbs="@Photo" /></Specimen>
</UiLayout>

@code {
    private static readonly IReadOnlyList<Crumb> Home = [new("Galleries")];
    private static readonly IReadOnlyList<Crumb> Gallery = [new("Galleries", "#"), new("September 6")];
    private static readonly IReadOnlyList<Crumb> Photo = [new("Galleries", "#"), new("September 6", "#"), new("Harbour at dusk")];
}
