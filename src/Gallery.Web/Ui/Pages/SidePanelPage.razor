<UiLayout Title="SidePanel">
    <Specimen Label="At rest" Width="w-320">
        <SidePanel Heading="Photo"><Fields /></SidePanel>
    </Specimen>
    <Specimen Label="Saving" Width="w-320">
        <SidePanel Heading="Photo" State="SaveState.Saving"><Fields /></SidePanel>
    </Specimen>
    <Specimen Label="Saved" Width="w-320">
        <SidePanel Heading="Photo" State="SaveState.Saved"><Fields /></SidePanel>
    </Specimen>
    <Specimen Label="With danger area" Width="w-320">
        <SidePanel Heading="Photo">
            <ChildContent><Fields /></ChildContent>
            <Danger>
                <DangerConfirm Id="ui-sp-confirm-closed" Action="Delete photo" Target="Mountain Lake" Title="Delete “Mountain Lake”?"
                               Consequence="It is in 2 galleries. This removes it from every gallery and deletes the original file. It can't be undone."
                               ConfirmLabel="Delete photo" />
            </Danger>
        </SidePanel>
    </Specimen>
    <Specimen Label="Delete confirm open" Width="w-320">
        <SidePanel Heading="Photo">
            <ChildContent><Fields /></ChildContent>
            <Danger>
                <DangerConfirm Id="ui-sp-confirm-open" Action="Delete photo" Target="Mountain Lake" Title="Delete “Mountain Lake”?"
                               Consequence="It is in 2 galleries. This removes it from every gallery and deletes the original file. It can't be undone."
                               ConfirmLabel="Delete photo" Open="true" />
            </Danger>
        </SidePanel>
    </Specimen>
</UiLayout>
