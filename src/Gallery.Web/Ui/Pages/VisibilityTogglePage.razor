@inject SampleCatalog Samples
<UiLayout Title="VisibilityToggle">
    <Specimen Label="Private">
        <VisibilityToggle Public="false" GalleryTitle="Coast, winter" PhotoCount="24" Warning="false" />
    </Specimen>
    <Specimen Label="Public">
        <VisibilityToggle Public="true" GalleryTitle="Coast, winter" PhotoCount="24" Warning="false" />
    </Specimen>
    <Specimen Label="Publish warning">
        <VisibilityToggle Public="false" GalleryTitle="Coast, winter" PhotoCount="24" Warning="true" />
    </Specimen>
    <Specimen Label="Part of a Save form (warning shows while switched on)">
        <form id="vt-save"><VisibilityToggle Public="false" GalleryTitle="Coast, winter" PhotoCount="24" FormId="vt-save" PartOfSave="true" /></form>
    </Specimen>
</UiLayout>
