<a class="@Class" href="@Href" rel="@RelValue" target="@Target">@ChildContent</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public string? Rel { get; set; }

    /// <summary>
    /// "_blank" opens a new tab. Owner rule: a link whose text ends in ↗ MUST set this, and only such
    /// links may carry the arrow. A new-tab link gets rel="noopener" unless Rel is given.
    /// </summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>Feature 010 (K1): true adds the site's one 44×44 tap box, class "text-link tap".</summary>
    [Parameter] public bool Tap { get; set; }

    private string Class => Tap ? "text-link tap" : "text-link";

    private string? RelValue => Rel ?? (Target == "_blank" ? "noopener" : null);
}
