@* Renders nothing at all when there is no value: no dash, no empty label (US2-3). *@
@if (!string.IsNullOrEmpty(Value))
{
    <span class="exif"><span class="visually-hidden">@Label: </span>@Value</span>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
}
