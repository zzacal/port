@* Admin visibility-toggle molecule (feature 005): switch to publish/unpublish a gallery, with publish warning. *@
@* While the publish warning is up the switch shows the requested state (on), per contract. *@
<Switch Label="Public" Name="public" Checked="@(Public || Warning)" Hint="@Hint" />
@if (Warning)
{
    <div class="publish-warning" role="alert">
        <span class="bang" aria-hidden="true">!</span>
        <p>Make &#x201C;@GalleryTitle&#x201D; public? It will be listed on the home page with its @PhotoCount photos, and anyone can see them.</p>
        <div class="actions">
            <Button Variant="ButtonVariant.Primary" FormId="@FormId">Make public</Button>
            <Button Variant="ButtonVariant.Quiet" Type="button" FormId="@FormId">Keep private</Button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Public { get; set; }
    [Parameter] public string GalleryTitle { get; set; } = "";
    [Parameter] public int PhotoCount { get; set; }
    [Parameter] public bool Warning { get; set; }
    [Parameter] public string? FormId { get; set; }

    private string Hint => Public
        ? "Public: listed on the home page."
        : "Private: not listed anywhere. People with the link can still open it.";
}
