@* A missing direction renders nothing (no disabled link). *@
<nav class="pager" aria-label="Image navigation">
    <span class="prev">
        @if (!string.IsNullOrEmpty(PrevHref))
        {
            <TextLink Href="@PrevHref" Rel="prev" Tap="true">Previous</TextLink>
        }
    </span>@HereContent
    <span class="next">
        @if (!string.IsNullOrEmpty(NextHref))
        {
            <TextLink Href="@NextHref" Rel="next" Tap="true">Next</TextLink>
        }
    </span>
</nav>

@code {
    [Parameter] public string? PrevHref { get; set; }
    [Parameter] public string? NextHref { get; set; }

    /// <summary>Feature 010 (K2): centre content, rendered as div.here between the two sides.</summary>
    [Parameter] public RenderFragment? Here { get; set; }

    private RenderFragment? HereContent => Here is null ? null : @<div class="here">@Here</div>;
}
