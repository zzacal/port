<nav class="@NavClass" aria-label="Site">
    <ul>
        @foreach (var item in Items)
        {
            <li>
                @if (item.Current)
                {
                    <a href="@item.Href" aria-current="page">@item.Text</a>
                }
                else
                {
                    <a href="@item.Href">@item.Text</a>
                }
            </li>
        }
    </ul>
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NavItem> Items { get; set; } = [];

    /// <summary>011 (contracts/components.md C2): the home page's big, centred links. Unset renders as before.</summary>
    [Parameter] public bool Home { get; set; }

    private string NavClass => Home ? "nav nav--home" : "nav";
}
