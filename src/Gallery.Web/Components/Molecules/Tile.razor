@* One contact-sheet cell (D-20): the whole photo letterboxed and centred in a fixed 4:3
   cell, title only below. The Tile owns the link; there is no separate picture-link.
   Admin additions (feature 005, all optional; public output byte-identical when unset): Overlay
   controls over the photo (drawn inside Picture's letterboxed frame, so they are placed from the
   photo's own corners, not the cell's), an extra root class, a caption under the title, and no link.
   Feature 015 (K3, optional, defaults byte-identical): TitleOnPhoto draws the title in a band at the
   photo's bottom edge (a sibling after .overlay inside the frame) instead of under the cell; Id sets
   the root id. Both are expressions that render null by default, never @if beside the markup.
   Branch bodies are deliberately unindented: Razor emits their whitespace verbatim, and
   PublicOutputUnchangedTests pins the public markup byte-for-byte. *@
@if (Image is null)
{
<a class="tile tile-empty" href="@Href" id="@Id">
    <div class="cell"></div><Title Text="@EmptyTitle" />
</a>
}
else if (!string.IsNullOrEmpty(Href))
{
<a class="@RootClass" href="@Href" id="@Id" data-preload-srcset="@PreloadSrcSet" data-preload-sizes="@PreloadSizes">
    <div class="cell">
        <Picture Image="Image" Sizes="@Sizes" Fit="PictureFit.Contain" Priority="Priority" TransitionId="@TransitionId" ChildContent="@PhotoLayer" />
    </div>
    @(TitleUnder)@Caption
</a>
}
else
{
<div class="@RootClass" id="@Id">
    <div class="cell">
        <Picture Image="Image" Sizes="@Sizes" Fit="PictureFit.Contain" Priority="Priority" TransitionId="@TransitionId" ChildContent="@PhotoLayer" />
    </div>
    @(TitleUnder)@Caption
</div>
}

@code {
    [Parameter] public ImageView? Image { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter, EditorRequired] public string Sizes { get; set; } = "";
    [Parameter] public PicturePriority Priority { get; set; } = PicturePriority.Lazy;

    /// <summary>Admin controls drawn over the cell (feature 005).</summary>
    [Parameter] public RenderFragment? Overlay { get; set; }

    /// <summary>Extra class on the root, e.g. is-selected / is-private (feature 005).</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Content after the title, e.g. "Private" (feature 005).</summary>
    [Parameter] public RenderFragment? Caption { get; set; }

    /// <summary>Title shown when Image is null (E-16); a null Image without EmptyTitle is an error.</summary>
    [Parameter] public string? EmptyTitle { get; set; }

    /// <summary>Passed to Picture.TransitionId (006).</summary>
    [Parameter] public string? TransitionId { get; set; }

    /// <summary>data-preload-srcset on the root anchor (006).</summary>
    [Parameter] public string? PreloadSrcSet { get; set; }

    /// <summary>data-preload-sizes on the root anchor (006).</summary>
    [Parameter] public string? PreloadSizes { get; set; }

    /// <summary>Draw the title on the photo's bottom edge instead of under the cell (015 K3).</summary>
    [Parameter] public bool TitleOnPhoto { get; set; }

    /// <summary>id on the tile root (015 K3).</summary>
    [Parameter] public string? Id { get; set; }

    protected override void OnParametersSet()
    {
        if (Image is null && string.IsNullOrEmpty(EmptyTitle))
            throw new ArgumentException("Image is required when EmptyTitle is not set.", nameof(Image));
    }

    private RenderFragment? OverlayLayer => Overlay is null ? null : @<div class="overlay">@Overlay</div>;

    private RenderFragment? OnPhotoLayer => !TitleOnPhoto || Image is null ? null : @<div class="on-photo"><Title Text="@Image.Title" /></div>;

    // Picture's ChildContent: the overlay, then the on-photo title as its sibling (never inside it).
    // Exactly OverlayLayer when TitleOnPhoto is off, so the default output is unchanged.
    private RenderFragment? PhotoLayer => OnPhotoLayer is not { } onPhoto
        ? OverlayLayer
        : builder =>
        {
            builder.AddContent(0, OverlayLayer);
            builder.AddContent(1, onPhoto);
        };

    private RenderFragment? TitleUnder => TitleOnPhoto || Image is null ? null : @<Title Text="@Image.Title" />;

    private string RootClass => string.IsNullOrEmpty(CssClass) ? "tile" : "tile " + CssClass;
}
