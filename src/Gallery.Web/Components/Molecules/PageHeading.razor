@* A page's title row with its page-level actions on the right (010 owner review 1, B6). Global
   bars hold navigation and account only; a page's own create action sits here. Without Text the
   row holds only the actions: an admin section root is already named by the owner bar and breadcrumb. *@
<div class="page-heading">@TitleContent@ActionsContent</div>

@code {
    [Parameter] public string? Text { get; set; }

    private RenderFragment? TitleContent => string.IsNullOrEmpty(Text) ? null : @<h1>@Text</h1>;
    [Parameter] public RenderFragment? Actions { get; set; }

    private RenderFragment? ActionsContent => Actions is null ? null : @<div class="page-actions">@Actions</div>;
}
