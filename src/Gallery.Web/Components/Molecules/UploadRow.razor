@* Feature 020 K7: one upload in the workspace tray: the file name, then the state's words
   ("Waiting", "Preparing", a progress bar, "Adding", "Added", the reason or "Interrupted" with
   Retry and Remove). data-item carries the batch item id (the 008 C2 name upload.js reads). *@
<div class="ws-up" data-item="@ItemId">
    <span class="ws-up-name" title="@FileName">@FileName</span>
    @StateContent
</div>

@code {
    [Parameter, EditorRequired] public string FileName { get; set; } = "";
    [Parameter] public UploadRowState State { get; set; }
    [Parameter] public int Percent { get; set; }
    [Parameter] public string? Reason { get; set; }
    [Parameter] public string? ItemId { get; set; }

    private RenderFragment StateContent => State switch
    {
        UploadRowState.Waiting => @<span class="ws-up-state ws-up-muted">Waiting</span>,
        UploadRowState.Preparing => @<span class="ws-up-state">Preparing</span>,
        UploadRowState.Uploading => @<progress class="ws-up-bar" value="@Percent" max="100">@(Percent)%</progress>,
        UploadRowState.Adding => @<span class="ws-up-state">Adding</span>,
        UploadRowState.Added => @<span class="ws-up-state ws-up-ok">Added</span>,
        UploadRowState.Failed => Problem(Reason ?? ""),
        _ => Problem("Interrupted"),
    };

    private RenderFragment Problem(string words) => @<span class="ws-up-state ws-up-problem"><span class="ws-up-reason">@words</span><Button Variant="ButtonVariant.Quiet" Type="button" Name="action" Value="retry" AriaLabel="@($"Retry {FileName}")">Retry</Button><Button Variant="ButtonVariant.Quiet" Type="button" Name="action" Value="remove" AriaLabel="@($"Remove {FileName}")">Remove</Button></span>;
}
