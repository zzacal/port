@* Admin layout template (feature 005): full document with owner bar, main, and optional aside. *@
@* 020 C-05: with List set it renders the workspace frame (K1) instead; List null is today's document. *@
@inject Gallery.Web.Styles.InlineStyles Styles
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    <meta name="robots" content="noindex">
    <style>@((MarkupString)Styles.Css)</style>
</head>
@(List is null ? ClassicBody : WorkspaceBody)
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public AdminPage? Current { get; set; }
    /// <summary>
    /// The breadcrumb under the owner bar. Constitution IX: the layout draws it on every page with the
    /// bar, so the content starts at the same height everywhere. Null shows the section's own name
    /// (or the page title) as the one, current, item.
    /// </summary>
    [Parameter] public IReadOnlyList<Crumb>? Crumbs { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowOwnerBar { get; set; } = true;
    [Parameter] public FormToken? SignOut { get; set; }

    // ── 020 workspace mode (K1, C-05): set List to get the three-region frame ──
    /// <summary>The collections list (left region). Non-null switches the layout to the workspace frame.</summary>
    [Parameter] public RenderFragment? List { get; set; }
    /// <summary>The details panel (right region) of the workspace frame.</summary>
    [Parameter] public RenderFragment? Panel { get; set; }
    /// <summary>The CSRF request token the workspace script sends (<c>data-csrf</c>).</summary>
    [Parameter] public FormToken? Csrf { get; set; }
    /// <summary>The bulk cap, <c>Library:PageSize</c> (<c>data-cap</c>).</summary>
    [Parameter] public int Cap { get; set; }
    /// <summary>The upload module address (<c>data-upload-src</c>).</summary>
    [Parameter] public string? UploadSrc { get; set; }
    /// <summary>The upload worker address (<c>data-worker-src</c>).</summary>
    [Parameter] public string? WorkerSrc { get; set; }

    private string BodyClass => Aside is not null ? "admin-body with-aside" : "admin-body";

    // One bar on every admin page (010 owner review 1): same links, View site, Sign out; only aria-current differs.
    private RenderFragment Bar => @<OwnerBar Current="@Current" SignOut="@SignOut" />;

    private RenderFragment? CrumbsContent => ShowOwnerBar ? @<Breadcrumb Items="Trail" /> : null;

    private IReadOnlyList<Crumb> Trail => Crumbs is { Count: > 0 } ? Crumbs : [new(Current switch
    {
        AdminPage.Upload => "Upload",
        AdminPage.Library => "Library",
        AdminPage.Galleries => "Galleries",
        _ => Title,
    })];

    // Today's body, unchanged (rendered when List is null).
    private RenderFragment ClassicBody => @<body class="admin">
    @(ShowOwnerBar ? Bar : null)@CrumbsContent
    <div class="@BodyClass">
        <main class="admin-main">@ChildContent</main>
        @if (Aside is not null)
        {
            <aside class="admin-aside">@Aside</aside>
        }
    </div>
</body>;

    // K1: no owner bar, no breadcrumb, no <script> (C-06: WorkspacePage renders the module script).
    private RenderFragment WorkspaceBody => @<body class="admin"><admin-workspace class="ws" data-csrf="@Csrf?.Value" data-cap="@Cap" data-upload-src="@UploadSrc" data-worker-src="@WorkerSrc"><nav class="ws-list">@List</nav><main class="ws-main">@ChildContent</main><aside class="ws-panel">@Panel</aside></admin-workspace></body>;
}
