@* Admin layout template (feature 005): full document with owner bar, main, and optional aside. *@
@inject Gallery.Web.Styles.InlineStyles Styles
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    <meta name="robots" content="noindex">
    <style>@((MarkupString)Styles.Css)</style>
</head>
<body class="admin">
    @(ShowOwnerBar ? Bar : null)@CrumbsContent
    <div class="@BodyClass">
        <main class="admin-main">@ChildContent</main>
        @if (Aside is not null)
        {
            <aside class="admin-aside">@Aside</aside>
        }
    </div>
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public AdminPage? Current { get; set; }
    /// <summary>
    /// The breadcrumb under the owner bar. Constitution IX: the layout draws it on every page with the
    /// bar, so the content starts at the same height everywhere. Null shows the section's own name
    /// (or the page title) as the one, current, item.
    /// </summary>
    [Parameter] public IReadOnlyList<Crumb>? Crumbs { get; set; }
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowOwnerBar { get; set; } = true;
    [Parameter] public FormToken? SignOut { get; set; }

    private string BodyClass => Aside is not null ? "admin-body with-aside" : "admin-body";

    // One bar on every admin page (010 owner review 1): same links, View site, Sign out; only aria-current differs.
    private RenderFragment Bar => @<OwnerBar Current="@Current" SignOut="@SignOut" />;

    private RenderFragment? CrumbsContent => ShowOwnerBar ? @<Breadcrumb Items="Trail" /> : null;

    private IReadOnlyList<Crumb> Trail => Crumbs is { Count: > 0 } ? Crumbs : [new(Current switch
    {
        AdminPage.Upload => "Upload",
        AdminPage.Library => "Library",
        AdminPage.Galleries => "Galleries",
        _ => Title,
    })];
}
