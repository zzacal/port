@* Admin layout template (020 K1): the workspace frame (collections list, main, details panel), or with
   Bare the bar-less document the sign-in page uses, byte-identical to the pre-020 sign-in layout. *@
@inject Gallery.Web.Styles.InlineStyles Styles
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    <meta name="robots" content="noindex">
    <style>@((MarkupString)Styles.Css)</style>
</head>
@(Bare ? BareBody : WorkspaceBody)
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>True renders only <see cref="ChildContent"/> in a padded main (the sign-in page), no workspace frame.</summary>
    [Parameter] public bool Bare { get; set; }
    /// <summary>The collections list (left region).</summary>
    [Parameter] public RenderFragment? List { get; set; }
    /// <summary>The middle region; with <see cref="Bare"/>, the whole page body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The details panel (right region).</summary>
    [Parameter] public RenderFragment? Panel { get; set; }
    /// <summary>The CSRF request token the workspace script sends (<c>data-csrf</c>).</summary>
    [Parameter] public FormToken? Csrf { get; set; }
    /// <summary>The bulk cap, <c>Library:PageSize</c> (<c>data-cap</c>).</summary>
    [Parameter] public int Cap { get; set; }
    /// <summary>The upload module address (<c>data-upload-src</c>).</summary>
    [Parameter] public string? UploadSrc { get; set; }
    /// <summary>The upload worker address (<c>data-worker-src</c>).</summary>
    [Parameter] public string? WorkerSrc { get; set; }

    // FR-001: the pre-020 sign-in document. Razor trims an element's leading whitespace, so the line
    // break that document has after <body> is written as markup.
    private static readonly MarkupString BodyIndent = new("\n    ");

    private RenderFragment BareBody => @<body class="admin">@BodyIndent<div class="admin-body"><main class="admin-main">@ChildContent</main></div></body>;

    // K1: no <script> (C-06: WorkspacePage renders the module script).
    private RenderFragment WorkspaceBody => @<body class="admin"><admin-workspace class="ws" data-csrf="@Csrf?.Value" data-cap="@Cap" data-upload-src="@UploadSrc" data-worker-src="@WorkerSrc"><nav class="ws-list">@List</nav><main class="ws-main">@ChildContent</main><aside class="ws-panel">@Panel</aside></admin-workspace></body>;
}
