@inject Gallery.Web.Styles.InlineStyles Styles
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    @if (NoIndex)
    {
        <meta name="robots" content="noindex">
    }
    <style>@((MarkupString)Styles.Css)</style>@if (HeadExtra is not null){@HeadExtra}
</head>
<body class="public">
    <SiteHeader SiteName="Gallery" />
    <main class="public-main">@ChildContent</main>@if (Enhance)
{
    <script type="speculationrules">{"prerender":[{"where":{"href_matches":"/g/*"},"eagerness":"moderate"}]}</script>
    <script type="module">(() => {
document.addEventListener('keydown', e => {
const k = { ArrowLeft: 'a[rel=prev]', ArrowRight: 'a[rel=next]', Escape: '.gallery-link a' }[e.key];
if (!k || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey || e.defaultPrevented || e.target.closest?.('input,textarea,select,[contenteditable]')) return;
document.querySelector('article.solo ' + k)?.click();
});
if (navigator.connection?.saveData) return;
// Fetch through a detached <picture> with the destination's own AVIF <source> (same srcset and
// sizes), so the browser picks, and caches, exactly the file the destination page then uses.
const warm = (srcset, sizes, priority) => {
    const pic = document.createElement('picture');
    const img = Object.assign(document.createElement('img'), { fetchPriority: priority, decoding: 'async' });
    pic.append(Object.assign(document.createElement('source'), { type: 'image/avif', srcset, sizes }), img);
    img.src = 'data:,';
};
const onIntent = e => {
    const el = e.target.closest?.('[data-preload-srcset]');
    if (!el || el.dataset.preloaded) return;
    el.dataset.preloaded = '1';
    warm(el.dataset.preloadSrcset, el.dataset.preloadSizes || '100vw', 'high');
};
document.addEventListener('pointerenter', onIntent, true);
document.addEventListener('touchstart', onIntent, { passive: true });
window.addEventListener('load', () => {
    const sets = document.querySelector('article.solo[data-prefetch]')?.dataset.prefetch.split('|').filter(Boolean) ?? [];
    for (const srcset of sets) warm(srcset, '100vw', 'low');
});
})();</script>
}
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter] public bool Enhance { get; set; }
    [Parameter] public RenderFragment? HeadExtra { get; set; }
}
