@inject Gallery.Web.Styles.InlineStyles Styles
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Title</title>
    @if (NoIndex)
    {
        <meta name="robots" content="noindex">
    }
    <style>@((MarkupString)Styles.Css)</style>@if (HeadExtra is not null){@HeadExtra}
</head>
<body class="public">
    <SiteHeader SiteName="Gallery" NavItems="_nav" />
    <main class="public-main">@ChildContent</main>@if (Enhance)
{
    <script type="speculationrules">{"prerender":[{"where":{"href_matches":"/g/*"},"eagerness":"moderate"}]}</script>
    <script type="module">(() => {
if (navigator.connection?.saveData) return;
const preload = e => {
    const el = e.target.closest?.('[data-preload-srcset]');
    if (!el || el.dataset.preloaded) return;
    el.dataset.preloaded = '1';
    const l = Object.assign(document.createElement('link'), { rel: 'preload', as: 'image', fetchPriority: 'high' });
    l.setAttribute('imagesrcset', el.dataset.preloadSrcset);
    l.setAttribute('imagesizes', el.dataset.preloadSizes || '100vw');
    document.head.appendChild(l);
};
document.addEventListener('pointerenter', preload, true);
document.addEventListener('touchstart', preload, { passive: true });
window.addEventListener('load', () => {
    const urls = document.querySelector('article.solo[data-prefetch]')?.dataset.prefetch.split(' ').filter(Boolean) ?? [];
    for (const href of urls) document.head.appendChild(Object.assign(document.createElement('link'), { rel: 'prefetch', as: 'image', href }));
});
})();</script>
}
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter] public bool Enhance { get; set; }
    [Parameter] public RenderFragment? HeadExtra { get; set; }

    private static readonly IReadOnlyList<NavItem> _nav = [new("Galleries", "/")];
}
