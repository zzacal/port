@* Solo image view: thumbnail-first layering (IV.15), photo letterboxed in a viewport-bounded
   stage, then title, metadata, and previous/next. The photo is not a link (III.1).
   New parameters 006: Caption, TransitionId, PrefetchUrls. When unset output is byte-identical.
   Branch bodies are unindented: Razor emits whitespace verbatim. *@
<article class="solo" data-prefetch="@PrefetchUrls">
    <div class="stage">
        <Picture Image="Image" Sizes="100vw" Fit="PictureFit.Contain" Priority="PicturePriority.High" ShowThumbLayer="true" TransitionId="@TransitionId" />
    </div>
    <div class="caption">
        <Title Text="@Image.Title" Element="h1" />@CaptionContent
        <MetadataBar Exif="Image.Exif" />
        <Pager PrevHref="@PrevHref" NextHref="@NextHref" />
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ImageView Image { get; set; } = default!;
    [Parameter] public string? PrevHref { get; set; }
    [Parameter] public string? NextHref { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? TransitionId { get; set; }
    [Parameter] public string? PrefetchUrls { get; set; }

    private RenderFragment? CaptionContent => Caption is not null
        ? b => b.AddMarkupContent(0, $"<p class=\"solo-caption\">{System.Web.HttpUtility.HtmlEncode(Caption)}</p>")
        : null;
}
