@* Admin side panel organism (feature 005): heading, fields slot, save state, optional danger slot. *@
<aside class="side-panel" aria-label="@Heading">
    <h2>@Heading</h2>@HeadAction
    <div class="sp-fields">@ChildContent</div>
    @(Save ? SaveRow : null)
    @if (Danger is not null)
    {
        <div class="sp-danger">
            <h3>Delete</h3>
            @Danger
        </div>
    }
</aside>

@code {
    [Parameter, EditorRequired] public string Heading { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public SaveState State { get; set; } = SaveState.Idle;
    [Parameter] public string SaveLabel { get; set; } = "Save";

    /// <summary>Demoted to Secondary when another control in the panel holds the one filled action (P1).</summary>
    [Parameter] public ButtonVariant SaveVariant { get; set; } = ButtonVariant.Primary;
    [Parameter] public RenderFragment? Danger { get; set; }
    [Parameter] public string? FormId { get; set; }

    /// <summary>
    /// Feature 020 T057: a control in the heading row, after the heading (the workspace's Done). Optional; the
    /// default render is byte-identical. Rendered in <c>.sp-head-action</c>, laid out beside the h2.
    /// </summary>
    [Parameter] public RenderFragment? HeadingAction { get; set; }

    private RenderFragment? HeadAction => HeadingAction is null ? null : @<div class="sp-head-action">@HeadingAction</div>;

    /// <summary>Feature 020 K2: false renders no save row (the workspace saves on leave). Default render byte-identical.</summary>
    [Parameter] public bool Save { get; set; } = true;

    private RenderFragment SaveRow => @<div class="sp-save">
        <Button Variant="@SaveVariant" Busy="@(State == SaveState.Saving)" FormId="@FormId">@(State == SaveState.Saving ? "Saving" : SaveLabel)</Button>
        <span class="sp-status">@(State == SaveState.Saved ? "Saved" : "")</span>
    </div>;
}
