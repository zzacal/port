<PublicLayout Title="@($"{Image.Title} — {GalleryTitle}")" NoIndex="@NoIndex" Enhance="true" HeadExtra="_transitions">
    <SoloViewer Image="Image" Caption="@Caption" PrevHref="@PrevHref" NextHref="@NextHref"
                TransitionId="@Image.Id" PrefetchUrls="@PrefetchUrls" Here="Here" Stack="Stack" />
</PublicLayout>

@code {
    [Parameter, EditorRequired] public ImageView Image { get; set; } = default!;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? PrevHref { get; set; }
    [Parameter] public string? NextHref { get; set; }
    [Parameter] public string? PrefetchUrls { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter, EditorRequired] public string GalleryTitle { get; set; } = "";

    /// <summary>
    /// Feature 010 (P1): the way back to the photo's tile, with its 1-based position. Optional:
    /// null renders no gallery link and the Pager's default stack, exactly as before.
    /// </summary>
    [Parameter] public string? GalleryHref { get; set; }
    [Parameter] public int Index { get; set; }
    [Parameter] public int Total { get; set; }

    private RenderFragment? Here => GalleryHref is null
        ? null
        : @<GalleryLink Href="@GalleryHref" Title="@GalleryTitle" Index="@Index" Total="@Total" />;

    private PagerStack Stack => GalleryHref is null
        ? PagerStack.None
        : GalleryLink.StackFor(GalleryTitle, Index, Total);

    private RenderFragment _transitions => b =>
    {
        var rule = $"#p-{Image.Id}{{view-transition-name:img-{Image.Id}}}";
        b.AddMarkupContent(0, $"<style>{rule}</style>");
    };
}
