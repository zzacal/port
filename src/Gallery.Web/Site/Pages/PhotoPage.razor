<PublicLayout Title="@($"{Image.Title} — {GalleryTitle}")" NoIndex="@NoIndex" Enhance="true" HeadExtra="_transitions" Crumbs="Trail">
    <SoloViewer Image="Image" Caption="@Caption" PrevHref="@PrevHref" NextHref="@NextHref"
                TransitionId="@Image.Id" PrefetchUrls="@PrefetchUrls" Here="Here" />
</PublicLayout>

@code {
    [Parameter, EditorRequired] public ImageView Image { get; set; } = default!;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? PrevHref { get; set; }
    [Parameter] public string? NextHref { get; set; }
    [Parameter] public string? PrefetchUrls { get; set; }
    [Parameter] public bool NoIndex { get; set; }
    [Parameter, EditorRequired] public string GalleryTitle { get; set; } = "";

    /// <summary>
    /// Feature 010 (owner review 1, B2/B3): the gallery crumb's href (the photo's tile) and the
    /// photo's 1-based position. Optional: null/0 render no breadcrumb and no count, as before.
    /// </summary>
    [Parameter] public string? GalleryHref { get; set; }
    [Parameter] public int Index { get; set; }
    [Parameter] public int Total { get; set; }

    /// <summary>
    /// 013 K3: an explicit trail (the camera photo page). Optional: null keeps the GalleryHref rule.
    /// </summary>
    [Parameter] public IReadOnlyList<Crumb>? Crumbs { get; set; }

    private IReadOnlyList<Crumb>? Trail => Crumbs ?? (GalleryHref is null
        ? null
        : Trails.Under(new Crumb(GalleryTitle, GalleryHref), new Crumb(Image.Title)));

    private RenderFragment? Here => Total <= 0
        ? null
        : @<PhotoCount Index="@Index" Total="@Total" />;

    private RenderFragment _transitions => b =>
    {
        var rule = $"#p-{Image.Id}{{view-transition-name:img-{Image.Id}}}";
        b.AddMarkupContent(0, $"<style>{rule}</style>");
    };
}
